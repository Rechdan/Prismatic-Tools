{
  "name": "prismatic-tools",
  "version": "1.0.0",
  "author": "Nelson Faiçal Rechdan <rechdanfr@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n app,widgets \"yarn dev:app\" \"yarn dev:widgets\"",
    "dev:app": "nodemon -w \"./src\" -e \"*\" -x \"yarn win\"",
    "dev:widgets": "nodemon -w \"./widgets\" -e \"*\" --on-change-only -x \"python3 scripts/winrun.py --sync-widgets\"",
    "win": "python3 scripts/winrun.py",
    "win:release": "python3 scripts/winrun.py --release"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.5.0",
    "concurrently": "10.0.3",
    "nodemon": "3.1.14"
  }
}
